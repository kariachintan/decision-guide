# Copy to .env and fill in. Never commit .env.
# "simulated" (default) runs fully offline with a deterministic templated model.
# "anthropic" calls the Claude API and requires ANTHROPIC_API_KEY.
DECISION_GUIDE_LLM_PROVIDER=simulated
ANTHROPIC_API_KEY=
# Model id to use when provider=anthropic (see https://docs.claude.com/en/docs/about-claude/models)
DECISION_GUIDE_LLM_MODEL=
